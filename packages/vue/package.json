{
  "name": "@yk-pet/vue",
  "version": "0.1.0",
  "description": "Vue 3 wrapper for <yk-pet>.",
  "type": "module",
  "license": "MIT",
  "author": "Yokry He",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
