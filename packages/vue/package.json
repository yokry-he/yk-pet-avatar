  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@yk-pet/element": "workspace:*",
    "vue": ">=3.3"
  },
  "dependencies": {
    "@yk-pet/core": "workspace:*"
  }
}
