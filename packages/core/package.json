{
  "name": "@yk-pet/core",
  "version": "0.1.0",
  "description": "Pet model, versioned config schema, motion, and the agent-facing avatar API.",
  "type": "module",
  "license": "MIT",
  "author": "Yokry He",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yokry-he/yk-pet-avatar.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "schema"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs core"
  }
}
