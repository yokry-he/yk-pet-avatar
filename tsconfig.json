{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@yk-pet/core": ["packages/core/src/index.ts"],
      "@yk-pet/2d": ["packages/renderer-2d/src/index.ts"],
      "@yk-pet/3d": ["packages/renderer-3d/src/index.ts"],
      "@yk-pet/element": ["packages/element/src/index.ts"],
      "@yk-pet/react": ["packages/react/src/index.tsx"],
      "@yk-pet/vue": ["packages/vue/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "scripts"],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/vite.config.ts"]
}
